# Soccer Predictor — Environment Variables
# Copy this to .env and fill in your values

# === API Keys ===
# Get free key at https://www.api-football.com/
API_FOOTBALL_KEY=your_api_football_key_here

# Get free key at https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here

# === Database ===
# Local PostgreSQL (recommended)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soccer_predictor

# === App Settings ===
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# === Scheduler ===
# How often to sync data (in hours)
DATA_SYNC_INTERVAL_HOURS=6
